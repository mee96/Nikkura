# Copy to .env and fill in. Never commit the real .env.

# local or production
ENVIRONMENT=local

# MySQL `nikkura` schema on Aiven (Service settings > Connection information)
DB_HOST=
DB_PORT=
DB_NAME=nikkura
DB_USER=
DB_PASSWORD=
# Path to the CA certificate from the Aiven console (ca.pem). Aiven requires SSL.
DB_SSL_CA=./ca.pem

# Frontend origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:4200
