# Copy to .env and fill in. Never commit the real .env.

# local or production
ENVIRONMENT=local

# MySQL `nikkura` schema on Aiven (Service settings > Connection information)
DB_HOST=
DB_PORT=
DB_NAME=nikkura
DB_USER=
DB_PASSWORD=
# Path to the CA certificate from the Aiven console (ca.pem). Aiven requires SSL.
DB_SSL_CA=./ca.pem

# Firebase project whose ID tokens the API accepts (public, same as in the frontend)
FIREBASE_PROJECT_ID=nikkura-d36d0
# Optional: JSON of a service account. Not needed to verify tokens; leave empty.
FIREBASE_CREDENTIALS_JSON=

# Frontend origins allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:4200

# Windows with Smart App Control or a company App Control policy may block the
# compiled parts of SQLAlchemy ("DLL load failed"). Set this in the shell, not here:
#   PowerShell: $env:DISABLE_SQLALCHEMY_CEXT_RUNTIME = "1"
#   cmd:        setx DISABLE_SQLALCHEMY_CEXT_RUNTIME 1
